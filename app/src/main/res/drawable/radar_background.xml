<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer circle -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    
    <!-- Middle circle -->
    <item
        android:left="40dp"
        android:top="40dp"
        android:right="40dp"
        android:bottom="40dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#22FFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    
    <!-- Inner circle -->
    <item
        android:left="80dp"
        android:top="80dp"
        android:right="80dp"
        android:bottom="80dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#11FFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
