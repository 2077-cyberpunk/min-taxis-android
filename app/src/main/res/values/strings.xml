    <!-- Safety -->
    <string name="safety_title">Safety &amp; Security</string>
    <string name="safety_description">Our staff is thoroughly trained in business etiquette and courtesy services. All drivers go through a safe driving course provided by the Traffic Safety Council of Zimbabwe. Each vehicle is thoroughly checked to ensure it is roadworthy.</string>

    <!-- FAQ -->
    <string name="faq_title">Frequently Asked Questions</string>
    <string name="faq_1_question">How do I book a taxi?</string>
    <string name="faq_1_answer">Booking a taxi with MIN Taxis is simple. You can book by calling our dispatch center at the provided phone numbers. Our team will assist you in arranging your transportation.</string>
    <string name="faq_2_question">What payment options are available?</string>
    <string name="faq_2_answer">MIN Taxis offers various payment options including cash, travel vouchers for contracted services, and prepaid services for personal contracts.</string>
    <string name="faq_3_question">Do you operate 24/7?</string>
    <string name="faq_3_answer">Yes, our dispatch rooms are operational 24/7, every day of the year. You can access our taxi services whenever you need them.</string>
    <string name="faq_4_question">How can I track my taxi?</string>
    <string name="faq_4_answer">Our taxis are equipped with UHF radios, allowing for quick allocation and up-to-the-minute location tracking without being affected by mobile network congestion.</string>
    <string name="faq_5_question">Can I hire a bus for an event?</string>
    <string name="faq_5_answer">Yes! MIN Taxis offers bus and coach hiring for weddings, corporate events, school trips, and group travel. Contact us for custom quotes.</string>
    <string name="faq_6_question">Do you offer airport transfers?</string>
    <string name="faq_6_answer">Yes, we provide reliable airport transfer services to and from Robert Gabriel Mugabe International Airport. Drivers track flight schedules and wait for you at arrivals.</string>
    <string name="faq_7_question">What car rental options do you have?</string>
    <string name="faq_7_answer">We offer daily, weekly, and monthly car rentals including sedans, SUVs, and vans. All vehicles are well-maintained and come with comprehensive insurance.</string>

    <!-- Clients -->
    <string name="trade_references">Trade References</string>
    <string name="clients_include">Our valued clients include Delta, Deloitte, British Council, Save the Children, BancABC, CARE, OK Zimbabwe, ZB Bank, Stanbic Bank, Simbisa, and Oxfam.</string>

