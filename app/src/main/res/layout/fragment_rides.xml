<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mintaxis_navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_rides"
            android:textColor="@color/mintaxis_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Tab Layout -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/mintaxis_navy_dark"
            app:tabIndicatorColor="@color/mintaxis_yellow"
            app:tabSelectedTextColor="@color/mintaxis_yellow"
            app:tabTextColor="@color/mintaxis_text_muted">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upcoming" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/completed" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancelled" />

        </com.google.android.material.tabs.TabLayout>

        <!-- Empty State -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_car"
                android:tint="@color/mintaxis_navy_light"
                android:alpha="0.5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_rides_yet"
                android:textColor="@color/mintaxis_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ride_history_empty"
                android:textColor="@color/mintaxis_text_muted"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:gravity="center" />

            <Button
                android:id="@+id/bookFirstRide"
                style="@style/MinTaxis.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/book_a_ride"
                android:textSize="14sp"
                android:layout_marginTop="20dp"
                android:minWidth="180dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
