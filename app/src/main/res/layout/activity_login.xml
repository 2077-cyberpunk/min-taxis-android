<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mintaxis_navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_background"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            android:scaleType="centerInside"
            android:tint="@color/mintaxis_white" />

        <!-- Logo -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@mipmap/ic_launcher"
            android:scaleType="fitCenter"
            android:layout_marginTop="20dp"
            android:layout_gravity="center" />

        <!-- Welcome Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_back"
            android:textColor="@color/mintaxis_text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_subtitle"
            android:textColor="@color/mintaxis_text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:layout_gravity="center" />

        <!-- Phone Number Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/phoneLayout"
            style="@style/MinTaxis.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/phone_number"
            android:layout_marginTop="32dp"
            app:startIconDrawable="@drawable/ic_phone"
            app:startIconTint="@color/mintaxis_yellow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/phoneNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:padding="16dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordLayout"
            style="@style/MinTaxis.TextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/password"
            android:layout_marginTop="12dp"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="@color/mintaxis_yellow"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/mintaxis_text_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:padding="16dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Forgot Password -->
        <TextView
            android:id="@+id/forgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/forgot_password"
            android:textColor="@color/mintaxis_yellow"
            android:textSize="13sp"
            android:padding="8dp"
            android:layout_gravity="end"
            android:layout_marginTop="4dp" />

        <!-- Login Button -->
        <Button
            android:id="@+id/loginButton"
            style="@style/MinTaxis.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/login"
            android:textSize="16sp"
            android:layout_marginTop="20dp" />

        <!-- Divider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/mintaxis_navy_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/or_continue_with"
                android:textColor="@color/mintaxis_text_muted"
                android:textSize="12sp"
                android:paddingHorizontal="12dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/mintaxis_navy_light" />

        </LinearLayout>

        <!-- Social Login Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:layout_gravity="center">

            <ImageButton
                android:id="@+id/googleButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/circle_background"
                android:src="@drawable/ic_google"
                android:scaleType="centerInside"
                android:contentDescription="Google"
                android:layout_marginEnd="12dp" />

            <ImageButton
                android:id="@+id/facebookButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/circle_background"
                android:src="@drawable/ic_facebook"
                android:scaleType="centerInside"
                android:contentDescription="Facebook" />

        </LinearLayout>

        <!-- Register Link -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dont_have_account"
                android:textColor="@color/mintaxis_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/registerLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sign_up"
                android:textColor="@color/mintaxis_yellow"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
