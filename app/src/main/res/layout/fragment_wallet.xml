<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mintaxis_navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Balance Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/online_card_background"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/available_balance"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/balanceAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/balance_amount"
                android:textColor="@color/mintaxis_yellow"
                android:textSize="40sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <Button
                    android:id="@+id/topUpButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/premium_button_background"
                    android:backgroundTint="@null"
                    android:text="@string/top_up"
                    android:textColor="@color/mintaxis_navy"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/withdrawButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/vehicle_option_background"
                    android:text="@string/withdraw"
                    android:textColor="@color/mintaxis_text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Payment Methods Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/payment_methods"
            android:textColor="@color/mintaxis_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="20dp" />

        <!-- Cash -->
        <LinearLayout
            android:id="@+id/cashOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/location_item_background"
            android:padding="16dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_wallet"
                android:tint="@color/mintaxis_yellow" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cash"
                    android:textColor="@color/mintaxis_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pay_with_cash"
                    android:textColor="@color/mintaxis_text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <RadioButton
                android:id="@+id/cashRadio"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:buttonTint="@color/mintaxis_yellow"
                android:checked="true" />

        </LinearLayout>

        <!-- EcoCash -->
        <LinearLayout
            android:id="@+id/ecocashOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/location_item_background"
            android:padding="16dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_wallet"
                android:tint="@color/mintaxis_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ecocash"
                    android:textColor="@color/mintaxis_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mobile_money"
                    android:textColor="@color/mintaxis_text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <RadioButton
                android:id="@+id/ecocashRadio"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:buttonTint="@color/mintaxis_yellow" />

        </LinearLayout>

        <!-- Travel Vouchers -->
        <LinearLayout
            android:id="@+id/voucherOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/location_item_background"
            android:padding="16dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_wallet"
                android:tint="@color/mintaxis_orange" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/travel_vouchers"
                    android:textColor="@color/mintaxis_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="For contracted services"
                    android:textColor="@color/mintaxis_text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <RadioButton
                android:id="@+id/voucherRadio"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:buttonTint="@color/mintaxis_yellow" />

        </LinearLayout>

        <!-- Corporate -->
        <LinearLayout
            android:id="@+id/corporateOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/location_item_background"
            android:padding="16dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_wallet"
                android:tint="@color/mintaxis_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/corporate"
                    android:textColor="@color/mintaxis_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prepaid service for companies"
                    android:textColor="@color/mintaxis_text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <RadioButton
                android:id="@+id/corporateRadio"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:buttonTint="@color/mintaxis_yellow" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
