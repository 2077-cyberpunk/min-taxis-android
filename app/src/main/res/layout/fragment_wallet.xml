<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mintaxis_navy"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wallet"
            android:textColor="@color/mintaxis_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Balance Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/MinTaxis.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/mintaxis_navy_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/available_balance"
                    android:textColor="@color/mintaxis_text_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/balanceAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/balance_amount"
                    android:textColor="@color/mintaxis_yellow"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/topUpButton"
                        style="@style/MinTaxis.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/top_up"
                        android:textSize="13sp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/withdrawButton"
                        style="@style/MinTaxis.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="@string/withdraw"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Payment Methods -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/payment_methods"
            android:textColor="@color/mintaxis_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <!-- Cash -->
        <LinearLayout
            android:id="@+id/cashOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/location_item_background"
            android:padding="14dp"
            android:layout_marginTop="8dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_wallet"
                android:tint="@color/mintaxis_yellow" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cash"
                    android:textColor="@color/mintaxis_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pay_with_cash"
                    android:textColor="@color/mintaxis_text_muted"
                    android:textSize="11sp" />

            </LinearLayout>

            <RadioButton
                android:id="@+id/cashRadio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:buttonTint="@color/mintaxis_yellow"
                android:checked="true" />

        </LinearLayout>

        <!-- EcoCash -->
        <LinearLayout
            android:id="@+id/ecocashOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/location_item_background"
            android:padding="14dp"
            android:layout_marginTop="6dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_wallet"
                android:tint="@color/mintaxis_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ecocash"
                    android:textColor="@color/mintaxis_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mobile_money"
                    android:textColor="@color/mintaxis_text_muted"
                    android:textSize="11sp" />

            </LinearLayout>

            <RadioButton
                android:id="@+id/ecocashRadio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:buttonTint="@color/mintaxis_yellow" />

        </LinearLayout>

        <!-- Travel Vouchers -->
        <LinearLayout
            android:id="@+id/voucherOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/location_item_background"
            android:padding="14dp"
            android:layout_marginTop="6dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_wallet"
                android:tint="@color/mintaxis_orange" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/travel_vouchers"
                    android:textColor="@color/mintaxis_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="For contracted services"
                    android:textColor="@color/mintaxis_text_muted"
                    android:textSize="11sp" />

            </LinearLayout>

            <RadioButton
                android:id="@+id/voucherRadio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:buttonTint="@color/mintaxis_yellow" />

        </LinearLayout>

        <!-- Corporate -->
        <LinearLayout
            android:id="@+id/corporateOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/location_item_background"
            android:padding="14dp"
            android:layout_marginTop="6dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_wallet"
                android:tint="@color/mintaxis_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/corporate"
                    android:textColor="@color/mintaxis_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prepaid service for companies"
                    android:textColor="@color/mintaxis_text_muted"
                    android:textSize="11sp" />

            </LinearLayout>

            <RadioButton
                android:id="@+id/corporateRadio"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:buttonTint="@color/mintaxis_yellow" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
