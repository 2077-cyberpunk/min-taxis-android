<?xml version="1.0" encoding="utf-8"?>
<ScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mintaxis_navy">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_background"
                android:src="@drawable/ic_back"
                android:scaleType="centerInside"
                android:tint="@color/mintaxis_white"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Book a Ride"
                android:textColor="@color/mintaxis_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="48dp" />

        </LinearLayout>

        <!-- Location Inputs Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/locationCard"
            style="@style/MinTaxis.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerLayout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Pickup Location -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_circle"
                        android:tint="@color/mintaxis_green" />

                    <EditText
                        android:id="@+id/pickupLocation"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:hint="Pick-up location"
                        android:inputType="text"
                        android:textColor="@color/mintaxis_text_primary"
                        android:textColorHint="@color/mintaxis_text_muted"
                        android:textSize="16sp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/edit_text_background"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

                <!-- Divider Line -->
                <View
                    android:layout_width="2dp"
                    android:layout_height="24dp"
                    android:background="@color/mintaxis_navy_light"
                    android:layout_marginStart="11dp" />

                <!-- Destination -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_square"
                        android:tint="@color/mintaxis_red" />

                    <EditText
                        android:id="@+id/destination"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:hint="Destination"
                        android:inputType="text"
                        android:textColor="@color/mintaxis_text_primary"
                        android:textColorHint="@color/mintaxis_text_muted"
                        android:textSize="16sp"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/edit_text_background"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Fare Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fareCard"
            style="@style/MinTaxis.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/locationCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Set Your Fare"
                    android:textColor="@color/mintaxis_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="16dp">

                    <SeekBar
                        android:id="@+id/fareSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="80"
                        android:progress="15"
                        android:progressTint="@color/mintaxis_yellow"
                        android:thumbTint="@color/mintaxis_yellow" />

                    <TextView
                        android:id="@+id/fareValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$20"
                        android:textColor="@color/mintaxis_yellow"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginStart="16dp" />

                </LinearLayout>

                <!-- Fare Suggestions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/suggestion1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$15"
                        android:textColor="@color/mintaxis_text_muted"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:background="@drawable/suggestion_background"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/suggestion2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$20"
                        android:textColor="@color/mintaxis_yellow"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:background="@drawable/suggestion_selected_background"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/suggestion3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$25"
                        android:textColor="@color/mintaxis_text_muted"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:background="@drawable/suggestion_background"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/suggestion4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="$30"
                        android:textColor="@color/mintaxis_text_muted"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:background="@drawable/suggestion_background"
                        android:padding="12dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Vehicle Selection -->
        <TextView
            android:id="@+id/vehicleTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Vehicle"
            android:textColor="@color/mintaxis_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fareCard" />

        <LinearLayout
            android:id="@+id/vehicleOptions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vehicleTitle">

            <!-- Sedan -->
            <LinearLayout
                android:id="@+id/sedanOption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/vehicle_option_selected_background"
                android:padding="16dp"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_car"
                    android:tint="@color/mintaxis_yellow" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sedan"
                    android:textColor="@color/mintaxis_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1-4 passengers"
                    android:textColor="@color/mintaxis_text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- SUV -->
            <LinearLayout
                android:id="@+id/suvOption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/vehicle_option_background"
                android:padding="16dp"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_car"
                    android:tint="@color/mintaxis_text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SUV"
                    android:textColor="@color/mintaxis_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1-6 passengers"
                    android:textColor="@color/mintaxis_text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Van -->
            <LinearLayout
                android:id="@+id/vanOption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/vehicle_option_background"
                android:padding="16dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_car"
                    android:tint="@color/mintaxis_text_muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Van"
                    android:textColor="@color/mintaxis_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1-8 passengers"
                    android:textColor="@color/mintaxis_text_muted"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Find Drivers Button -->
        <Button
            android:id="@+id/findDriversButton"
            style="@style/MinTaxis.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:text="Find Drivers"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vehicleOptions" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
