<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mintaxis_navy">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/mintaxis_yellow"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_background"
            android:src="@drawable/ic_back"
            android:scaleType="centerInside"
            android:tint="@color/mintaxis_navy"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Promotions &amp; Offers"
            android:textColor="@color/mintaxis_navy"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginEnd="40dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Overall Promo Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/gallery_card_background"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4 Active Offers"
                    android:textColor="@color/mintaxis_yellow"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save up to 30% on rides"
                    android:textColor="@color/mintaxis_text_muted"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <!-- Promo Card 1: First Ride Free -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/promo_red_background"
                android:padding="16dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="First Ride Free!"
                    android:textColor="@color/mintaxis_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New users get their first ride absolutely free. No minimum fare."
                    android:textColor="@color/mintaxis_white"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USE CODE: FREEMINTAXI"
                    android:textColor="@color/mintaxis_yellow"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- Promo Card 2: Refer & Earn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/promo_green_background"
                android:padding="16dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Refer &amp; Earn"
                    android:textColor="@color/mintaxis_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Invite friends and earn $5 credit for each referral. Both you and your friend get rewarded."
                    android:textColor="@color/mintaxis_white"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share your referral code with friends"
                    android:textColor="@color/mintaxis_yellow"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- Promo Card 3: Airport Transfer Special -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/promo_orange_background"
                android:padding="16dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Airport Transfer Special"
                    android:textColor="@color/mintaxis_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Book airport transfers 24 hours in advance and get 15% off. Available for RGM Airport."
                    android:textColor="@color/mintaxis_white"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USE CODE: AIRPORT15"
                    android:textColor="@color/mintaxis_yellow"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

            <!-- Promo Card 4: Corporate Monthly Pass -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/info_card_background"
                android:padding="16dp"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Corporate Monthly Pass"
                    android:textColor="@color/mintaxis_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Businesses get unlimited rides within Harare for a flat monthly rate. Contact us for custom pricing."
                    android:textColor="@color/mintaxis_white"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CALL: +263 772 887 897"
                    android:textColor="@color/mintaxis_yellow"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
