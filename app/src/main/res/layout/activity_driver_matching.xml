<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mintaxis_navy">

    <!-- Radar Animation Container -->
    <FrameLayout
        android:id="@+id/radarContainer"
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:layout_constraintBottom_toTopOf="@id/statusText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <!-- Radar Background -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/radar_background"
            android:scaleType="fitCenter" />

        <!-- Radar Sweep -->
        <ImageView
            android:id="@+id/radarSweep"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/radar_sweep"
            android:scaleType="fitCenter" />

        <!-- Center Icon -->
        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_profile"
            android:background="@drawable/circle_background"
            android:padding="10dp"
            android:tint="@color/mintaxis_yellow"
            android:layout_gravity="center" />

        <!-- Driver Dots -->
        <ImageView
            android:id="@+id/driverDot1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_car"
            android:background="@drawable/dot_background"
            android:padding="6dp"
            android:tint="@color/mintaxis_yellow"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp" />

        <ImageView
            android:id="@+id/driverDot2"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_car"
            android:background="@drawable/dot_background"
            android:padding="6dp"
            android:tint="@color/mintaxis_yellow"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="32dp" />

        <ImageView
            android:id="@+id/driverDot3"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_car"
            android:background="@drawable/dot_background"
            android:padding="6dp"
            android:tint="@color/mintaxis_yellow"
            android:layout_gravity="top|end"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="40dp" />

    </FrameLayout>

    <!-- Status Text -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/finding_drivers"
        android:textColor="@color/mintaxis_text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/radarContainer" />

    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/looking_for_best"
        android:textColor="@color/mintaxis_text_muted"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:paddingHorizontal="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/progress_drawable"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitleText" />

    <!-- Cancel Button -->
    <Button
        android:id="@+id/cancelButton"
        style="@style/MinTaxis.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="@string/cancel"
        android:textSize="15sp"
        android:layout_marginBottom="40dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
